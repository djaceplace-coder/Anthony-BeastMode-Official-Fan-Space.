rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'adereraadenike@gmail.com' ||
        (request.auth.token.keys().hasAll(['role']) && request.auth.token.role in ['super_admin', 'content_admin', 'tour_admin', 'fan_support', 'partnerships']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /test/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /artist_profile/{id} {
      allow read, write: if true;
    }

    match /releases/{id} {
      allow read, write: if true;
    }

    match /tracks/{id} {
      allow read, write: if true;
    }

    match /platforms/{id} {
      allow read, write: if true;
    }

    match /cities/{id} {
      allow read, write: if true;
    }

    match /venues/{id} {
      allow read, write: if true;
    }

    match /shows/{id} {
      allow read, write: if true;
    }

    match /tours/{id} {
      allow read, write: if true;
    }

    match /events/{id} {
      allow read, write: if true;
    }

    match /news_posts/{id} {
      allow read, write: if true;
    }

    match /copy_items/{id} {
      allow read, write: if true;
    }

    match /merch_items/{id} {
      allow read, write: if true;
    }

    match /site_settings/{id} {
      allow read, write: if true;
    }

    match /media/{id} {
      allow read, write: if true;
    }

    match /media_slots/{id} {
      allow read, write: if true;
    }

    match /offers/{id} {
      allow read, write: if true;
    }

    match /offer_metrics/{id} {
      allow read, write: if true;
    }

    match /ticket_clicks/{id} {
      allow read, write: if true;
    }

    match /offer_clicks/{id} {
      allow read, write: if true;
    }

    match /fan_downloads/{id} {
      allow read, write: if true;
    }

    match /members/{userId} {
      allow read, write: if true;
    }

    match /member_follows/{id} {
      allow read, write: if true;
    }

    match /conversations/{convId} {
      allow read, write: if true;

      match /messages/{msgId} {
        allow read, write: if true;
      }

      match /internal_notes/{noteId} {
        allow read, write: if true;
      }
    }

    match /notifications/{id} {
      allow read, write: if true;
    }

    match /inquiries/{id} {
      allow read, write: if true;
    }

    match /audit_log/{id} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    match /admins/{id} {
      allow read, write: if isAdmin();
    }
  }
}
